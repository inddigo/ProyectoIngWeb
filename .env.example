# Copiar a .env antes de `docker compose up`. Nunca subir .env al repositorio.
POSTGRES_USER=pastry_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pastry_db
POSTGRES_PORT=5432
# Generar con: openssl rand -hex 32
JWT_SECRET=
CORS_ORIGINS=http://localhost:4200,http://localhost:8100,http://localhost,capacitor://localhost
FRONTEND_PORT=8080
# false para no crear usuarios de demostración
SEED_DEMO_DATA=true
