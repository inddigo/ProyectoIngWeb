# Copiar a .env para ejecutar el backend fuera de Docker (npm run start:dev)
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://pastry_user:change_me@localhost:5432/pastry_db?schema=public
PYTHON_SERVICE_URL=http://localhost:8000
# Obligatoria en producción (mínimo 32 caracteres). Generar con: openssl rand -hex 32
JWT_SECRET=
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:4200,http://localhost:8100,capacitor://localhost,http://localhost
# Seed de datos de demo
SEED_DEMO_DATA=true
SEED_BAKER_PASSWORD=
SEED_CLIENT_PASSWORD=
