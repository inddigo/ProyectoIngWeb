generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  BAKER
  ADMIN
}

// Ciclo de vida de un pedido:
// CONFIRMED_BY_CLIENT -> QUOTED -> ACCEPTED_BY_CLIENT | REJECTED_BY_CLIENT
// (DRAFT y STRUCTURED quedan reservados para borradores guardados antes de confirmar)
enum OrderStatus {
  DRAFT
  STRUCTURED
  CONFIRMED_BY_CLIENT
  QUOTED
  ACCEPTED_BY_CLIENT
  REJECTED_BY_CLIENT
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@map("users")
}

model Order {
  id              String      @id @default(uuid())
  clientId        String      @map("client_id")
  // Rubro del pedido (cake, tattoo, ...). Los atributos varían por rubro y se guardan en JSON.
  domain          String      @default("cake")
  rawText         String      @map("raw_text")
  status          OrderStatus @default(CONFIRMED_BY_CLIENT)
  attributes      Json?
  imageUrl        String?     @map("image_url")
  confidenceScore Float?      @map("confidence_score")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  client        User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  webReferences WebReference[]
  quote         Quote?

  @@index([status])
  @@index([clientId])
  @@map("orders")
}

model WebReference {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  title     String
  imageUrl  String   @map("image_url")
  source    String
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("web_references")
}

model Quote {
  id             String   @id @default(uuid())
  orderId        String   @unique @map("order_id")
  estimatedPrice Decimal  @map("estimated_price") @db.Decimal(10, 2)
  details        String
  // Desglose de la calculadora de costos (insumos, mano de obra, margen)
  breakdown      Json?
  createdAt      DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("quotes")
}
